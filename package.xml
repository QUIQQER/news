<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/news" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/news" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="content.news-publishing">
