                <attribute default="0">quiqqer.settings.news.showTime</attribute>
                <attribute default="disabled">quiqqer.settings.news.filter</attribute>
                <attribute>quiqqer.settings.news.tags</attribute>

                <!-- card template (template = cards) -->
                <attribute default="standard">quiqqer.settings.news.cards.layout</attribute>
                <attribute default="3">quiqqer.settings.news.cards.columns</attribute>
                <attribute>quiqqer.settings.news.cards.columnsTablet</attribute>
                <attribute default="1">quiqqer.settings.news.cards.columnsMobile</attribute>
                <attribute default="cover">quiqqer.settings.news.cards.imageFit</attribute>
                <attribute default="3/2">quiqqer.settings.news.cards.aspectRatio</attribute>
                <attribute default="normal">quiqqer.settings.news.cards.gap</attribute>

                <!-- media list template (template = mediaList) -->
                <attribute default="left">quiqqer.settings.news.media.imagePosition</attribute>
                <attribute default="normal">quiqqer.settings.news.media.imageWidth</attribute>

                <!-- default type / layout for new child sites -->
                <attribute default="quiqqer/news:types/news-article">quiqqer.settings.children.type</attribute>
                <attribute>quiqqer.settings.children.layout</attribute>
            </attributes>

